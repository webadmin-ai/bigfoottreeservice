---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import {
	BUSINESS_ADDRESS,
	BUSINESS_EMAIL,
	BUSINESS_PHONE,
	BUSINESS_PHONE_TEL,
	SITE_TITLE,
	SOCIAL_LINKS,
} from '../consts';
import HeaderLink from './HeaderLink.astro';

const services = [
	{ href: '/tree-removal/', label: 'Tree Removal' },
	{ href: '/stump-removal/', label: 'Stump Removal' },
	{ href: '/firewood/', label: 'Firewood' },
	{ href: '/tree-trimming/', label: 'Tree Trimming' },
	{ href: '/storm-damage/', label: 'Storm Damage' },
	{ href: '/crane-service/', label: 'Crane Service' },
];
---

<header>
	<div class="announcement-bar">
		<div class="announcement-bar-inner">
			<div class="social-links">
				<a href={SOCIAL_LINKS.facebook} target="_blank" rel="noopener" aria-label="Facebook">
					<i class="fa-brands fa-facebook-square" aria-hidden="true"></i>
				</a>
				<a href={SOCIAL_LINKS.twitter} target="_blank" rel="noopener" aria-label="Twitter">
					<i class="fa-brands fa-twitter-square" aria-hidden="true"></i>
				</a>
				<a href={SOCIAL_LINKS.google} target="_blank" rel="noopener" aria-label="Google">
					<i class="fa-brands fa-google" aria-hidden="true"></i>
				</a>
				<a href={SOCIAL_LINKS.yelp} target="_blank" rel="noopener" aria-label="Yelp">
					<i class="fa-brands fa-yelp" aria-hidden="true"></i>
				</a>
			</div>
			<a class="call-text" href={`tel:${BUSINESS_PHONE_TEL}`}>
				Call or Text Today! {BUSINESS_PHONE}
			</a>
		</div>
	</div>
	<div class="top-bar">
		<div class="top-bar-inner">
			<a href="/" class="logo">
				<Image src={logo} alt={SITE_TITLE} width={300} height={108} />
			</a>
			<div class="contact-info">
				<a href={`mailto:${BUSINESS_EMAIL}`}>
					<i class="fa-regular fa-envelope" aria-hidden="true"></i> {BUSINESS_EMAIL}
				</a>
				<span class="address">
					<i class="fa-solid fa-location-dot" aria-hidden="true"></i> {BUSINESS_ADDRESS}
				</span>
			</div>
		</div>
	</div>
	<nav>
		<ul class="nav-links">
			<li><HeaderLink href="/">Home</HeaderLink></li>
			<li><HeaderLink href="/about-us/">About Us</HeaderLink></li>
			<li class="dropdown">
				<details>
					<summary>Services</summary>
					<ul class="dropdown-menu">
						{
							services.map((service) => (
								<li>
									<a href={service.href}>{service.label}</a>
								</li>
							))
						}
					</ul>
				</details>
			</li>
			<li><HeaderLink href="/servicing-areas/">Areas We Service</HeaderLink></li>
			<li><HeaderLink href="/photo-gallery/">Photo Gallery</HeaderLink></li>
			<li><HeaderLink href="/blog">Blog</HeaderLink></li>
			<li><HeaderLink href="/contact/">Contact</HeaderLink></li>
		</ul>
	</nav>
</header>
<style>
	header {
		margin: 0;
	}
	.announcement-bar {
		background: #000;
		color: #fff;
	}
	.announcement-bar-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0.5em 1em;
		font-size: 0.9em;
	}
	.social-links {
		display: flex;
		align-items: center;
		gap: 0.6em;
	}
	.social-links a {
		color: #fff;
		font-size: 1.3em;
		line-height: 1;
	}
	.call-text {
		color: #fff;
		text-decoration: none;
		font-weight: 700;
	}
	.top-bar {
		background: var(--topbar-bg);
		color: rgb(var(--gray-dark));
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.top-bar-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0.5em 1em;
	}
	.logo {
		display: inline-flex;
	}
	.logo img {
		display: block;
		border-radius: 0;
	}
	.contact-info {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.35em;
		line-height: 1.3;
		font-size: 0.95em;
	}
	.contact-info a {
		color: var(--link-color);
		text-decoration: none;
	}
	.contact-info .address {
		color: rgb(var(--gray-dark));
	}
	nav {
		background: var(--nav-bg);
	}
	.nav-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		list-style: none;
		margin: 0;
		padding: 0;
		max-width: 1200px;
		margin: 0 auto;
	}
	.nav-links :global(a) {
		display: block;
		padding: 1em 1.1em;
		color: #fff;
		text-decoration: none;
		border-bottom: 4px solid transparent;
		font-weight: 700;
	}
	.nav-links :global(a:hover),
	.nav-links :global(a.active) {
		border-bottom-color: var(--nav-active);
	}
	.dropdown {
		position: relative;
	}
	.dropdown details {
		position: relative;
	}
	.dropdown summary {
		display: block;
		padding: 1em 1.1em;
		color: #fff;
		font-weight: 700;
		cursor: pointer;
		list-style: none;
	}
	.dropdown summary::-webkit-details-marker {
		display: none;
	}
	.dropdown summary::after {
		content: ' \25BE';
	}
	.dropdown summary:hover {
		border-bottom: 4px solid var(--nav-active);
	}
	.dropdown-menu {
		list-style: none;
		margin: 0;
		padding: 0;
		position: absolute;
		top: 100%;
		left: 0;
		min-width: 200px;
		background: var(--nav-bg);
		box-shadow: var(--box-shadow);
		z-index: 10;
	}
	.dropdown-menu a {
		padding: 0.75em 1.1em;
		white-space: nowrap;
		border-bottom: none !important;
	}
	.dropdown-menu a:hover {
		background: var(--nav-active);
	}
	@media (max-width: 720px) {
		.announcement-bar-inner {
			flex-direction: column;
			align-items: center;
			gap: 0.4em;
			padding: 0.5em 1em;
			text-align: center;
			font-size: 0.8em;
		}
		.call-text {
			overflow-wrap: break-word;
		}
		.top-bar-inner {
			flex-direction: column;
			align-items: center;
			gap: 0.5em;
		}
		.contact-info {
			align-items: center;
			text-align: center;
			width: 100%;
			font-size: 0.7em;
		}
		.contact-info a,
		.contact-info .address {
			display: block;
			width: 100%;
			overflow-wrap: break-word;
		}
		.nav-links {
			justify-content: center;
		}
		.nav-links :global(a),
		.dropdown summary {
			padding: 0.6em 0.5em;
			font-size: 0.85em;
		}
		.dropdown-menu {
			position: static;
			min-width: 0;
		}
	}
</style>
