---
import Layout from '../layouts/Layout.astro';
import { BUSINESS_PHONE, BUSINESS_PHONE_TEL } from '../consts';
---

<Layout title="Page Not Found" description="Sorry, the page you're looking for could not be found.">
	<div class="content-page">
		<h1>404 &mdash; Page Not Found</h1>
		<p>
			Sorry, the page you're looking for doesn't exist. It may have been moved or removed.
		</p>
		<p>
			Need tree service in Northern New Jersey? Give us a call at <a
				href={`tel:${BUSINESS_PHONE_TEL}`}>{BUSINESS_PHONE}</a
			> or head back to our homepage.
		</p>
		<a class="cta" href="/">Back to Homepage</a>
	</div>
</Layout>

<style>
	.content-page {
		width: 720px;
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 6em 1em;
		text-align: center;
	}
	h1 {
		color: var(--accent);
		margin-bottom: 0.75em;
	}
	.cta {
		display: inline-block;
		margin-top: 1em;
		padding: 0.75em 2em;
		background: var(--accent);
		color: #fff;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-decoration: none;
		border-radius: 4px;
		font-size: 1.1em;
	}
	.cta:hover {
		background: var(--accent-dark);
	}
</style>
