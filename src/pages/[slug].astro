---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import ContentPage from '../layouts/ContentPage.astro';
import { BUSINESS_NAME } from '../consts';

export async function getStaticPaths() {
	const services = await getCollection('services');
	const areas = await getCollection('areas');

	return [...services, ...areas].map((entry) => ({
		params: { slug: entry.id },
		props: entry,
	}));
}

type Props = CollectionEntry<'services'> | CollectionEntry<'areas'>;

const entry = Astro.props;
const { Content } = await render(entry);

const isService = entry.collection === 'services';
const isArea = entry.collection === 'areas';

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const siteUrl = Astro.site?.toString() ?? '';

const serviceSchema = isService
	? JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'Service',
			name: entry.data.title,
			description: entry.data.description,
			provider: {
				'@type': 'LandscapeService',
				name: BUSINESS_NAME,
				url: siteUrl.replace(/\/$/, ''),
			},
			areaServed: 'Northern New Jersey',
		})
	: null;

const breadcrumbItems = isService
	? [
			{ '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
			{ '@type': 'ListItem', position: 2, name: 'Services', item: new URL('/#services', Astro.site).toString() },
			{ '@type': 'ListItem', position: 3, name: entry.data.title, item: pageUrl },
		]
	: isArea
		? [
				{ '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
				{
					'@type': 'ListItem',
					position: 2,
					name: 'Areas We Service',
					item: new URL('/servicing-areas/', Astro.site).toString(),
				},
				{ '@type': 'ListItem', position: 3, name: entry.data.title, item: pageUrl },
			]
		: null;

const breadcrumbSchema = breadcrumbItems
	? JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'BreadcrumbList',
			itemListElement: breadcrumbItems,
		})
	: null;
---

<ContentPage title={entry.data.title} description={entry.data.description}>
	<Fragment slot="head">
		{serviceSchema && <script type="application/ld+json" set:html={serviceSchema}></script>}
		{breadcrumbSchema && <script type="application/ld+json" set:html={breadcrumbSchema}></script>}
	</Fragment>
	<Content />
</ContentPage>
